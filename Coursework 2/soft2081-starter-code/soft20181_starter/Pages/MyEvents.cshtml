@page
@model MyEventsModel
@{
    ViewData["Title"] = "My Registered Events";
}

<div class="container py-5">
    <h1 class="mb-4">My Registered Events</h1>

    @if (Model.RegisteredEvents.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var eventItem in Model.RegisteredEvents)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(eventItem.Event.Image))
                        {
                            <img src="@eventItem.Event.Image" class="card-img-top" alt="@eventItem.Event.Title" style="height: 200px; object-fit: cover;">
                        }
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.Event.Title</h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-calendar-event"></i> @eventItem.Event.Date.ToString("MMMM dd, yyyy")<br>
                                <i class="bi bi-clock"></i> @eventItem.Event.Time<br>
                                <i class="bi bi-geo-alt"></i> @eventItem.Event.Location
                            </p>
                            <p class="card-text">@eventItem.Event.Description</p>
                        </div>
                        <div class="card-footer bg-transparent">
                            @if (eventItem.Event.Date >= DateTime.Today)
                            {
                                <button class="btn btn-danger btn-sm unregister-btn"
                                        data-event-id="@eventItem.Event.Id">
                                    Unregister
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">Event has passed</span>
                            }
                            <span class="float-end text-muted small">
                                Registered on @eventItem.RegistrationDate.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You haven't registered for any events yet.
        </div>
    }
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        document.querySelectorAll('.unregister-btn').forEach(button => {
            button.addEventListener('click', function() {
                const eventId = this.getAttribute('data-event-id');
                const card = this.closest('.card');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to attend this event if you unregister!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, unregister!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        axios.post('/Event_Details?handler=Unregister&eventId=' + eventId)
                            .then(response => {
                                if (response.data.success) {
                                    Swal.fire(
                                        'Unregistered!',
                                        'You have been unregistered from the event.',
                                        'success'
                                    );
                                    card.remove();
                                }
                            })
                            .catch(error => {
                                Swal.fire(
                                    'Error!',
                                    'An error occurred while unregistering.',
                                    'error'
                                );
                            });
                    }
                });
            });
        });
    </script>
}