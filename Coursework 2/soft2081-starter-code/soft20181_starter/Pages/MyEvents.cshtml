@page
@model MyEventsModel
@{
    ViewData["Title"] = "My Registered Events";
}

@Html.AntiForgeryToken()   <!-- antiforgery hidden input -->

<div class="min-h-screen bg-gray-50 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">My Registered Events</h1>

        @if (Model.RegisteredEvents.Any())
        {
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var eventItem in Model.RegisteredEvents)
                {
                    <div class="bg-white shadow-lg rounded-2xl overflow-hidden">
                        @if (!string.IsNullOrEmpty(eventItem.Event.Image))
                        {
                            <img src="@eventItem.Event.Image"
                                 alt="@eventItem.Event.Title"
                                 class="w-full h-48 object-cover" />
                        }

                        <div class="p-6 space-y-3">
                            <h2 class="text-xl font-semibold text-gray-900">
                                @eventItem.Event.Title
                            </h2>

                            <!-- ─────────────────── Labeled details ─────────────────── -->
                            <div class="text-sm text-gray-500 space-y-1">
                                <p class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                                    </svg>
                                    @eventItem.Event.Date.ToString("MMMM dd, yyyy")
                                </p>
                                <p class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                                    </svg>
                                    @eventItem.Event.Time
                                </p>
                                <p class="flex items-center">
                                    <svg class="h-5 w-5 text-gray-400 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                    </svg>
                                    @eventItem.Event.Location
                                </p>
                            </div>

                            <p class="text-gray-700 text-sm">
                                @eventItem.Event.Description
                            </p>
                        </div>

                        <div class="px-6 pb-6 flex justify-between items-center
                                    border-t border-gray-200 pt-4">
                            @if (eventItem.Event.Date >= DateTime.Today)
                            {
                                <button class="text-white bg-red-600 hover:bg-red-700 font-medium
                                               rounded-lg text-sm px-4 py-2 unregister-btn transition"
                                        data-event-id="@eventItem.Event.Id">
                                    Unregister
                                </button>
                            }
                            else
                            {
                                <span class="text-sm text-gray-400 italic">Event has passed</span>
                            }

                            <span class="text-sm text-gray-400">
                                Registered on @eventItem.RegistrationDate.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-blue-50 text-blue-700 px-6 py-4 rounded-lg shadow-sm mt-4">
                You haven't registered for any events yet.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.querySelectorAll('.unregister-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const eventId = this.dataset.eventId;
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to attend this event if you unregister!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#3b82f6',
                    confirmButtonText: 'Yes, unregister!'
                }).then(result => {
                    if (!result.isConfirmed) return;

                    this.disabled = true;   // prevent double‑clicks

                    axios.post(
                        `/MyEvents?handler=Unregister&eventId=${eventId}`,
                        null,
                        { headers: { 'RequestVerificationToken': token } }
                    )
                        .then(res => {
                            if (res.data?.success) {
                                Swal.fire('Unregistered!', 'You have been unregistered.', 'success')
                                    .then(() => window.location.reload());
                            } else {
                                Swal.fire('Error', 'Server could not unregister you.', 'error');
                                this.disabled = false;
                            }
                        })
                        .catch(err => {
                            Swal.fire('HTTP ' + (err.response?.status ?? ''),
                                err.response?.data ?? 'Request failed',
                                'error');
                            this.disabled = false;
                        });
                });
            });
        });
    </script>
}
