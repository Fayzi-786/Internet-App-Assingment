@page
@model soft20181_starter.Pages.ContactModel
@{
    ViewBag.Title = "Contact Us"; // Set the page title
}

<div class="contact-section fade-in">
    <h1>Contact Us</h1>
    <p>
        We'd love to hear from you. Please fill out the form or use the contact
        details below.
    </p>
    @Model.FormMessage
    <div class="contact-container">
        <div class="form-container">
            <h2>Get in Touch</h2>
            <form method="post">
                <div class="form-group">
                    <label asp-for="ContactInfo.Name"></label>
                    <input asp-for="ContactInfo.Name" class="form-control" placeholder="Your Name" />
                    <span asp-validation-for="ContactInfo.Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContactInfo.Email"></label>
                    <input asp-for="ContactInfo.Email" class="form-control" placeholder="Name@example.com" />
                    <span asp-validation-for="ContactInfo.Email" class="text-danger"></span>
                </div>
               
                <div class="form-group">
                    <label asp-for="ContactInfo.Message"></label>
                    <textarea asp-for="ContactInfo.Message" class="form-control" placeholder="What's on your mind! Let us know!"></textarea>
                    <span asp-validation-for="ContactInfo.Message" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
        <div class="info-container">
            <h2>Contact Details</h2>
            <p>
                <strong>Email:</strong>
                <a href="mailto:shaheer.fayzi@gmail.com">shaheer.fayzi@gmail.com</a>
            </p>
            <p><strong>Phone:</strong> +44 7467825599</p>
            <p>
                <strong>Follow Us:</strong>
                <a href="https://www.linkedin.com/in/shaheerullah-fayzi-9598052a9/">Linked In -</a>
                <a href="#">Instagram</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/contact.js"></script>
    <partial name="_ValidationScriptsPartial" />
}