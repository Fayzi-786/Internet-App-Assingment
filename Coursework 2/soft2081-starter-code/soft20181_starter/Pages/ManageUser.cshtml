@page
@model soft20181_starter.Pages.ManageUserModel
@{
    ViewData["Title"] = "Manage Users & Roles";
}

<h2>Manage Users</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <form method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@user.Id" />
                        <button type="submit" asp-page-handler="DeleteUser" class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this user?');">
                            Delete User
                        </button>
                    </form>

                    <form method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@user.Id" />
                        <input type="password" asp-for="NewPassword" class="form-control d-inline-block w-auto" placeholder="New Password" required />
                        <button type="submit" asp-page-handler="UpdatePassword" class="btn btn-sm btn-warning">Update Password</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2>Manage Roles</h2>

<form method="post">
    <div class="form-group">
        <label for="roleName">New Role Name:</label>
        <input type="text" asp-for="RoleName" class="form-control" required />
        <span asp-validation-for="RoleName" class="text-danger"></span>
    </div>
    <button type="submit" asp-page-handler="AddRole" class="btn btn-primary mt-2">Add New Role</button>
</form>

<hr>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Role ID</th>
            <th>Role Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model.Roles)
        {
            <tr>
                <td>@role.Id</td>
                <td>@role.Name</td>
                <td>
                    <form method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@role.Id" />
                        <button type="submit" asp-page-handler="DeleteRole" class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this role?');">
                            Delete Role
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}