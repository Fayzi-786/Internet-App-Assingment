@page
@model soft20181_starter.Pages.ManageUserModel
@{
    ViewData["Title"] = "Manage Users & Roles";
}

<div class="min-h-screen bg-gray-50 py-10 px-6">
    <div class="max-w-6xl mx-auto space-y-12">

        <div class="bg-white shadow-md rounded-2xl p-6">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">Manage Users</h2>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
                    <thead class="bg-gray-100 text-gray-600">
                        <tr>
                            <th class="px-4 py-2">User ID</th>
                            <th class="px-4 py-2">Username</th>
                            <th class="px-4 py-2">Email</th>
                            <th class="px-4 py-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="px-4 py-2">@user.Id</td>
                                <td class="px-4 py-2">@user.UserName</td>
                                <td class="px-4 py-2">@user.Email</td>
                                <td class="px-4 py-2 space-y-2 sm:space-y-0 sm:space-x-2 sm:flex sm:flex-wrap">
                                    <form method="post" class="inline-block">
                                        <input type="hidden" asp-for="Id" value="@user.Id" />
                                        <button type="submit"
                                                asp-page-handler="DeleteUser"
                                                class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-md text-xs"
                                                onclick="return confirm('Are you sure you want to delete this user?');">
                                            Delete
                                        </button>
                                    </form>

                                    <form method="post" class="inline-flex items-center space-x-2">
                                        <input type="hidden" asp-for="Id" value="@user.Id" />
                                        <input type="password"
                                               asp-for="NewPassword"
                                               class="form-input rounded-md border-gray-300 text-sm px-2 py-1"
                                               placeholder="New Password"
                                               required />
                                        <button type="submit"
                                                asp-page-handler="UpdatePassword"
                                                class="bg-yellow-400 hover:bg-yellow-500 text-white px-3 py-1 rounded-md text-xs">
                                            Update
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white shadow-md rounded-2xl p-6">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">Manage Roles</h2>

            <form method="post" class="space-y-4">
                <div>
                    <label for="roleName" class="block text-sm font-medium text-gray-700">New Role Name</label>
                    <input type="text"
                           asp-for="RoleName"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                           required />
                    <span asp-validation-for="RoleName" class="text-red-500 text-sm"></span>
                </div>

                <button type="submit"
                        asp-page-handler="AddRole"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-lg">
                    Add New Role
                </button>
            </form>

            <hr class="my-6 border-gray-300" />

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
                    <thead class="bg-gray-100 text-gray-600">
                        <tr>
                            <th class="px-4 py-2">Role ID</th>
                            <th class="px-4 py-2">Role Name</th>
                            <th class="px-4 py-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        @foreach (var role in Model.Roles)
                        {
                            <tr>
                                <td class="px-4 py-2">@role.Id</td>
                                <td class="px-4 py-2">@role.Name</td>
                                <td class="px-4 py-2">
                                    <form method="post" class="inline-block">
                                        <input type="hidden" asp-for="Id" value="@role.Id" />
                                        <button type="submit"
                                                asp-page-handler="DeleteRole"
                                                class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-md text-xs"
                                                onclick="return confirm('Are you sure you want to delete this role?');">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
