<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Find and discover amazing events, bootcamps, conferences, and meetings on our platform.">
    <title>@ViewBag.Title</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            600: '#2563eb',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Flowbite CSS CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />

    <!-- SweetAlert2 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- External JS CDNs -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @RenderSection("Styles", required: false)
</head>

<body class="flex flex-col min-h-screen bg-gray-50 text-gray-900">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white border-b shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="flex justify-between items-center py-4">
                <!-- Logo -->
                <a href="/" class="flex items-center space-x-2">
                    <img src="~/Assets/images/logo.png" alt="GatherUp" class="h-10 w-auto">
                    <span class="text-xl font-bold text-gray-800">GatherUp</span>
                </a>

                <!-- Mobile menu button -->
                <div class="flex md:hidden items-center space-x-4">
                    <button data-collapse-toggle="navbar-menu" type="button"
                            class="p-2 text-gray-500 rounded-lg hover:bg-gray-100"
                            aria-controls="navbar-menu" aria-expanded="false">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                    <partial name="_LoginPartial" class="md:hidden" />
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex items-center space-x-8">
                    <!-- Nav links -->
                    <ul class="flex space-x-6 text-sm font-medium">
                        <li><a href="/" class="text-gray-700 hover:text-primary-600 transition-colors">Home</a></li>
                        <li><a href="/Events" class="text-gray-700 hover:text-primary-600 transition-colors">Events</a></li>
                        <li><a href="/MyEvents" class="text-gray-700 hover:text-primary-600 transition-colors">My Events</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a href="/Admin/Events/Index" class="text-gray-700 hover:text-primary-600 transition-colors">Manage Events</a></li>
                            <li><a href="/ManageUser" class="text-gray-700 hover:text-primary-600 transition-colors">Users</a></li>
                        }
                        <li><a href="/Contact" class="text-gray-700 hover:text-primary-600 transition-colors">Contact</a></li>
                    </ul>

                    <!-- Login/Welcome -->
                    <div class="ml-6">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </div>

        <!-- Mobile menu -->
        <div class="hidden md:hidden bg-white border-t" id="navbar-menu">
            <ul class="px-4 py-2 space-y-2 text-sm font-medium">
                <li><a href="/" class="block py-2 text-gray-700 hover:text-primary-600">Home</a></li>
                <li><a href="/Events" class="block py-2 text-gray-700 hover:text-primary-600">Events</a></li>
                <li><a href="/MyEvents" class="block py-2 text-gray-700 hover:text-primary-600">My Events</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li><a href="/Admin/Events/Index" class="block py-2 text-gray-700 hover:text-primary-600">Manage Events</a></li>
                    <li><a href="/ManageUser" class="block py-2 text-gray-700 hover:text-primary-600">Users</a></li>
                }
                <li><a href="/Contact" class="block py-2 text-gray-700 hover:text-primary-600">Contact</a></li>
            </ul>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 sm:px-6 py-8">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t py-6 text-center text-sm text-gray-500">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="font-medium">Shaheerullah Fayzi</p>
            <p class="mt-1">
                Contact:
                <a href="mailto:shaheer.fayzi@gmail.com" class="text-primary-600 hover:underline">
                    shaheer.fayzi@gmail.com
                </a>
            </p>
            <p class="mt-1">&copy; 2025 Shaheerullah Fayzi. All rights reserved.</p>
        </div>
    </footer>

    <!-- Flowbite JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>