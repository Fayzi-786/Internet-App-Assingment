<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Find and discover amazing events, bootcamps, conferences, and meetings on our platform." />
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/contact.css"/>
    <link rel="stylesheet" href="~/css/event-details.css"/>
    <link rel="stylesheet" href="~/css/Event.css" />
    

    
    <title>@ViewBag.Title</title>
</head>
<body>
    <header class="header fade-in" id="header">
        <img class="logo" id="logo" aria-label="Website Logo" alt="gather up" src="~/Assets/images/logo.png" width="120px" height="120px">
        <nav class="nav" id="nav-menu">
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/" class="nav-link" id="home" title="Return To Home">Home</a>
                    <a href="/" class="mob-nav" id="mob-home" title="Return To Home">
                        <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"></path>
                            <path d="M9 22V12h6v10"></path>
                        </svg>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Events" class="nav-link" title="See All Events">Events</a>
                    <a href="/Events" class="mob-nav" title="See All Events">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="svg-icon" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="16" rx="2" ry="2"></rect>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                            <line x1="7" y1="4" x2="7" y2="20"></line>
                            <line x1="17" y1="4" x2="17" y2="20"></line>
                        </svg>
                    </a>
                </li>
                <a href="/ManageUser" class="nav-link" title="See All Events">Events</a>
                <li class="nav-item">
                    <a href="/Contact" class="nav-link" id="contact" title="Contact Us">Contact us</a>
                    <a href="/Contact" class="mob-link" id="contact" title="Contact Us">
                        <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12l-10 6-10-6"></path>
                            <path d="M2 6h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"></path>
                        </svg>
                    </a>
                </li>
            </ul>
            <partial name="_LoginPartial" />
        </nav>
    </header>
    <div class="overlay"></div>
    <div class="customization-panel fade-in">
        <span style="cursor: pointer" id="close_modal">
            <svg style="width: 30px; height: 30px; float: right" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                <path d="M12.243 3.757a.75.75 0 0 0-1.061 0L8 6.939 4.818 3.757a.75.75 0 1 0-1.061 1.061L6.939 8l-3.182 3.182a.75.75 0 1 0 1.061 1.061L8 9.061l3.182 3.182a.75.75 0 0 0 1.061-1.061L9.061 8l3.182-3.182a.75.75 0 0 0 0-1.061z" fill="currentColor" />
            </svg>
        </span>
        <h2>Customize Header</h2>
        <div class="input-group">
            <label for="fontSize">Font Size</label>
            <input type="number" id="fontSize" min="10" max="50" step="1" value="16" />
        </div>
        <div class="input-group">
            <label for="bgColor">Background Color</label>
            <input type="color" id="bgColor" value="#ffffff" />
        </div>
        <button id="savePreferences">Save Preferences</button>
    </div>
    <div class="mob-logo">
        <img class="" id="" aria-label="Website Logo" alt="gather up" src="~/Assets/images/logo.png" width="120px" height="120px">
    </div>

    @RenderBody()

    <footer>
        <p><strong>Shaheerullah Fayzi</strong></p>
        <p>
            Contact:
            <a href="mailto:shaheerullahfayzi@example.com">shaheer.fayzi@gmail.com</a>
        </p>
        <p>&copy; 2025 Shaheerullah Fayzi. All rights reserved.</p>
    </footer>

    <script src="~/js/index.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>