@using Microsoft.AspNetCore.Identity
@using soft20181_starter.Models
@inject SignInManager<UsersInfo> SignInManager
@inject UserManager<UsersInfo> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item d-flex align-items-center me-2">
        <a id="manage" class="nav-link text-dark fw-medium pe-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            👋 Hello, @UserManager.GetUserName(User)!
        </a>
    </li>
    <li class="nav-item d-flex align-items-center">
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" class="d-inline">
            <button id="logout" type="submit" class="btn btn-link text-danger fw-semibold p-0 m-0" style="text-decoration: none;">
                Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="nav-link text-dark fw-medium" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-medium" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
