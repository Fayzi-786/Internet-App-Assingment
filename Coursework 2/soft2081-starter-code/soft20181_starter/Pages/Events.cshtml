@page
@model EventsModel
@{
    ViewBag.Title = "Events";
}

<div class="search-container fade-in">
    <div class="search-bar">
        <label for="search-events" class="sr-only">Search for events</label>
        <input type="text" id="search-events" placeholder="Search for events, category, or locations..." />
        <div class="custom-select">
            <select id="filterSelect">
                <option value="" selected>All</option>
                <option value="location">Location</option>
                <option value="date">Date</option>
                <option value="title">Title</option>
            </select>
        </div>
    </div>
</div>

<!-- Event container to display the events -->
<div id="event-container-in-events" class="event-container-in-events fade-in">
    @foreach (var eventItem in Model.Events)
    {
        <div class="event-card">
            <h3>@eventItem.Title</h3>
            <p>@eventItem.Description</p>
            <p><strong>Location:</strong> @eventItem.Location</p>
            <p><strong>Date:</strong> @eventItem.Date.ToString("MMMM dd, yyyy")</p>
            <p><strong>Time:</strong> @eventItem.Time</p>
            <a asp-page="Event_Details" asp-route-id="@eventItem.Id"  class="btn btn-outline-primary">Learn more</a>
        </div>
    }
</div>

@section Scripts {
}
