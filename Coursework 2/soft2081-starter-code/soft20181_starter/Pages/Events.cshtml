@page
@model EventsModel
@{
    ViewBag.Title = "Events";
}

<div class="bg-white">
    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-indigo-600 to-blue-600 py-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto text-center">
            <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
                Discover Amazing Events
            </h1>
            <p class="mt-6 text-xl text-indigo-100 max-w-3xl mx-auto">
                Find conferences, workshops, and networking events to grow your skills and connections
            </p>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 -mt-10">
        <div class="bg-white rounded-xl shadow-lg p-6">
            <form method="get">
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-grow relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <input asp-for="SearchTerm"
                               type="text"
                               class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg bg-gray-50 focus:ring-indigo-500 focus:border-indigo-500"
                               placeholder="Search titles, locations...">
                    </div>
                    <div class="w-full md:w-auto">
                        <select asp-for="CategoryFilter"
                                class="block w-full pl-3 pr-10 py-3 text-base border border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 rounded-lg">
                            <option value="all">All Categories</option>
                            <option value="conference">Conferences</option>
                            <option value="meeting">Meetings</option>
                            <option value="networking">Networking</option>
                        </select>
                    </div>
                    <button type="submit"
                            class="px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors">
                        Search
                    </button>
                </div>
            </form>
        </div>
    </div>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var eventItem in Model.Events)
            {
                <div class="event-card bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300"
                     data-title="@eventItem.Title.ToLower()"
                     data-location="@eventItem.Location.ToLower()"
                     data-date="@eventItem.Date.ToString("MMM dd, yyyy").ToLower()"
                     data-category="@eventItem.Category?.ToLower()">
                    <div class="h-48 bg-gray-200 overflow-hidden">
                        <img src="@eventItem.Image"
                             alt="@eventItem.Title"
                             class="w-full h-full object-cover"
                             loading="lazy">
                    </div>
                    <div class="p-6">
                        <div class="flex items-center text-sm text-gray-500 mb-2">
                            <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                            </svg>
                            @eventItem.Location
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">@eventItem.Title</h3>
                        <p class="text-gray-600 mb-4 line-clamp-2">@eventItem.Description</p>

                        <div class="flex items-center justify-between mt-4">
                            <div class="flex items-center">
                                <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                                </svg>
                                <span class="text-sm text-gray-500">
                                    @eventItem.Date.ToString("MMM dd, yyyy") • @eventItem.Time
                                </span>
                            </div>
                            <a asp-page="Event_Details"
                               asp-route-id="@eventItem.Id"
                               class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
       
    </div>
</div>

@section Scripts {
    <script>
        // Enter key support
        document.querySelector('input[asp-for="SearchTerm"]').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                document.querySelector('form').submit();
            }
        });

        // Fix dropdown preservation
        document.querySelector('select[asp-for="CategoryFilter"]').value = "@Model.CategoryFilter";
    </script>
}