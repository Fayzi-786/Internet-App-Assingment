@page
@model soft20181_starter.Pages.Admin.Events.IndexModel
@{
    ViewData["Title"] = "Manage Events";
}
@Html.AntiForgeryToken()

<div class="min-h-screen bg-gray-50 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Manage Events</h1>
            <a class="bg-green-600 text-white px-5 py-2 rounded-lg hover:bg-green-700 transition"
               asp-page="/Admin/Events/Create">Create New Event</a>
        </div>

        <div class="overflow-x-auto bg-white shadow-md rounded-2xl">
            <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
                <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
                    <tr>
                        <th class="px-6 py-4">Event Name</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Location</th>
                        <th class="px-6 py-4">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var eventItem in Model.Events)
                    {
                        <tr id="event-@eventItem.Id" class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 font-medium text-gray-900">@eventItem.Title</td>
                            <td class="px-6 py-4">@eventItem.Date.ToString("MMM dd, yyyy")</td>
                            <td class="px-6 py-4">@eventItem.Location</td>
                            <td class="px-6 py-4 space-x-2">
                                
                                <a asp-page="/Admin/Events/Edit" asp-route-id="@eventItem.Id"
                                   class="inline-block bg-yellow-500 text-white px-3 py-1 rounded-md hover:bg-yellow-600 transition">Edit</a>
                                <button type="button"
                                        class="inline-block bg-red-600 text-white px-3 py-1 rounded-md hover:bg-red-700 transition"
                                        onclick="removeEvent('?handler=DeleteEvent', @eventItem.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
 
    <script>
        function removeEvent(url, id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            Swal.fire({
                title: "Are you sure?",
                text: "This action cannot be undone!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Yes, delete it!"
            }).then(res => {
                if (res.isConfirmed) {
                    axios.post(`${url}&id=${id}`, null, {
                        headers: {
                            'RequestVerificationToken': token
                        }
                    }).then(_ => {
                        Swal.fire("Deleted!", "The event has been removed.", "success");
                        document.getElementById(`event-${id}`).remove();
                    }).catch(err => {
                        Swal.fire("Could not Delete!", "Server is busy or error occurred.", "error");
                    });
                }
            });
        }
    </script>
}
