@page
@model soft20181_starter.Pages.Admin.Events.IndexModel
@{
    ViewData["Title"] = "Manage Events";
}
@Html.AntiForgeryToken()

<h1>@ViewData["Title"]</h1>

<div class="mb-3">
    <a class="btn btn-success" asp-page="/Admin/Events/Create">Create New Event</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Event Name</th>
            <th>Date</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var eventItem in Model.Events)
        {
            <tr id="event-@eventItem.Id">
                <td>@eventItem.Title</td>
                <td>@eventItem.Date.ToString("MM/dd/yyyy")</td>
                <td>@eventItem.Location</td>
                <td>
                    <a class="btn btn-primary " asp-page="/Admin/Events/Details" asp-route-id="@eventItem.Id">Details</a>
                    <a class="btn btn-primary " asp-page="/Admin/Events/Edit" asp-route-id="@eventItem.Id">Edit</a>
                    <button type="button" class="btn btn-danger" onclick="removeEvent('?handler=DeleteEvent', @eventItem.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {

    <script>
            
            function removeEvent(url,id){
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                Swal.fire({
                    title:"Are you sure",
                    text:"You can not undo this action!",
                    icon:"warning",
                    showCancelButton:true,
                    confirmButtonColor: "#d33",
                    confirmButtonText:"Yes, delete it!"
                }).then(res => {
                    if(res.isConfirmed){
                    console.log(`${url}${+id}`)
                        axios.post(`${url}&id=${+id}`,null,{
                             headers: {
            'RequestVerificationToken': token
        }
                        }).then(_ => {
                             Swal.fire({
                              title: "Deleted!",
                              text: "Your file has been deleted.",
                              icon: "success"
                            });
                            // remove the row from table
                            document.getElementById(`event-${id}`).innerHTML = "";
                        }).catch(err => {
                            Swal.fire({
                              title: "Could not Delete!",
                              text: "Server is busy.",
                              icon: "warning"
                            });
                        })
                    }
                })
            }
        
    </script>
}