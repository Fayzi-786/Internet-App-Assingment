@page
@model soft20181_starter.Pages.Admin.Events.EditModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="container">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form method="post" enctype="multipart/form-data" class="row g-3">
        <input type="hidden" asp-for="Event.Id" />

        @if (!string.IsNullOrEmpty(Model.Event.Image))
        {
            <div class="col-md-12 mb-3">
                <label class="form-label">Current Image</label>
                <div>
                    <img src="@Model.Event.Image" class="img-thumbnail" style="max-height: 200px;" />
                </div>
            </div>
        }

        <div class="col-md-6">
            <label asp-for="Event.Title" class="form-label">Title*</label>
            <input asp-for="Event.Title" class="form-control" required />
            <span asp-validation-for="Event.Title" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Event.Location" class="form-label">Location*</label>
            <input asp-for="Event.Location" class="form-control" required />
            <span asp-validation-for="Event.Location" class="text-danger"></span>
        </div>

        <div class="col-md-12">
            <label asp-for="Event.Description" class="form-label">Description*</label>
            <textarea asp-for="Event.Description" class="form-control" rows="3" required></textarea>
            <span asp-validation-for="Event.Description" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Event.Date" class="form-label">Date*</label>
            <input asp-for="Event.Date" class="form-control" type="date" required />
            <span asp-validation-for="Event.Date" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Event.Time" class="form-label">Time*</label>
            <input asp-for="Event.Time" class="form-control" type="time" required />
            <span asp-validation-for="Event.Time" class="text-danger"></span>
        </div>

        <div class="col-md-12">
            <label class="form-label">Upload New Image</label>
            <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" />
            <small class="form-text text-muted">Leave blank to keep current image</small>
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-primary">Update Event</button>
            <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Remove validation for ImageFile
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const imageInput = document.querySelector('input[type="file"]');

            // Prevent default file input validation
            imageInput.removeAttribute('data-val');
            imageInput.removeAttribute('data-val-required');

            form.addEventListener('submit', function () {
                // Clear any existing validation messages for file input
                const fileValidationMessages = document.querySelectorAll('[data-valmsg-for="ImageFile"]');
                fileValidationMessages.forEach(msg => msg.textContent = '');
            });
        });
    </script>
}