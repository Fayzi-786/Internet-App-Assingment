@page
@model soft20181_starter.Pages.Admin.Events.EditModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="min-h-screen bg-gray-50 py-10">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 bg-white shadow-md rounded-2xl p-8">
        <h2 class="text-3xl font-semibold text-gray-800 mb-6">@ViewData["Title"]</h2>

        <form method="post" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" asp-for="Event.Id" />

            @if (!string.IsNullOrEmpty(Model.Event.Image))
            {
                <div>
                    <label class="block text-sm font-medium text-gray-700">Current Image</label>
                    <div class="mt-2">
                        <img src="@Model.Event.Image" alt="Event Image" class="rounded-lg shadow max-h-52 object-cover" />
                    </div>
                </div>
            }

            <div>
                <label asp-for="Event.Title" class="block text-sm font-medium text-gray-700">Title</label>
                <input asp-for="Event.Title" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required />
                <span asp-validation-for="Event.Title" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Event.Location" class="block text-sm font-medium text-gray-700">Location</label>
                <input asp-for="Event.Location" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required />
                <span asp-validation-for="Event.Location" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Event.Description" class="block text-sm font-medium text-gray-700">Description</label>
                <textarea asp-for="Event.Description" rows="4" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required></textarea>
                <span asp-validation-for="Event.Description" class="text-red-500 text-sm"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Event.Date" class="block text-sm font-medium text-gray-700">Date</label>
                    <input asp-for="Event.Date" type="date" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required />
                    <span asp-validation-for="Event.Date" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Event.Time" class="block text-sm font-medium text-gray-700">Time</label>
                    <input asp-for="Event.Time" type="time" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required />
                    <span asp-validation-for="Event.Time" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Upload New Image</label>
                <input type="file" asp-for="ImageFile" accept="image/*" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 transition" />
                <p class="text-sm text-gray-500 mt-1">Leave blank to keep the current image</p>
            </div>

            <div class="flex justify-end space-x-4 pt-6">
                <button type="submit" class="bg-indigo-600 text-white px-5 py-2 rounded-lg hover:bg-indigo-700 transition">Update Event</button>
                <a asp-page="Index" class="px-5 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Clean up file input validation
        document.addEventListener('DOMContentLoaded', () => {
            const imageInput = document.querySelector('input[type="file"]');
            imageInput?.removeAttribute('data-val');
            imageInput?.removeAttribute('data-val-required');
        });
    </script>
}
