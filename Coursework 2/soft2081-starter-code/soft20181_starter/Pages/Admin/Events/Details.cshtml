@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="row g-0">
            <div class="col-md-5">
                @if (!string.IsNullOrEmpty(Model.Event.Image))
                {
                    <img src="@Model.Event.Image" class="img-fluid rounded-start" style="height: 100%; object-fit: cover;" alt="Event Image" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light" style="height: 100%;">
                        <span class="text-muted">No image uploaded</span>
                    </div>
                }
            </div>
            <div class="col-md-7">
                <div class="card-body p-4">
                    <h3 class="card-title">@Model.Event.Title</h3>
                    <p class="card-text text-muted mb-2">
                        <i class="bi bi-calendar-event me-2"></i>@Model.Event.Date.ToString("dddd, MMMM dd, yyyy")
                        <br />
                        <i class="bi bi-clock me-2"></i>@Model.Event.Time
                    </p>
                    <p class="card-text">
                        <strong>Location:</strong> @Model.Event.Location
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.Event.Description))
                    {
                        <p class="card-text">@Model.Event.Description</p>
                    }
                    <a asp-page="Index" class="btn btn-outline-primary mt-3">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
}
